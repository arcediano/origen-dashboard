# GitHub Packages Authentication
# Required to install @arcediano/ux-library from npm.pkg.github.com
# Generate token at: https://github.com/settings/tokens
# Required scope: read:packages
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Runtime environment (optional for local development)
NODE_ENV=development

# API Gateway URL (usada tanto en next.config.js como en los route handlers)
NEXT_PUBLIC_API_GATEWAY_URL=https://api.origen.es

# CDN base URL for image display (CloudFront or S3 public URL)
# Used to resolve raw S3 keys into viewable image URLs
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.origen.delivery

# Stripe — nunca documentadas aquí hasta ahora (encontrado al diagnosticar el
# error "No se pudo inicializar Stripe Connect" en producción, 2026-10-08:
# faltaba NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY en el entorno de Vercel).
#
# Clave pública — se usa en el navegador (Stripe Connect embedded onboarding
# en src/components/features/stripe/stripe-connect-onboarding.tsx y el
# checkout de créditos de IA en AddCreditsModal.tsx). Al ser NEXT_PUBLIC_*,
# Next.js la incrusta en el bundle en BUILD TIME, no en runtime -- cambiarla
# en Vercel exige un redeploy nuevo, no basta con guardar la variable.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<tu-clave-publica-de-stripe>

# Clave secreta — solo server-side (route handlers de /api/stripe/*,
# src/lib/stripe/server.ts). NUNCA debe llevar el prefijo NEXT_PUBLIC_.
STRIPE_SECRET_KEY=<tu-clave-secreta-de-stripe>
